{
  "name": "aerotizen-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:simulator": "vite --mode simulator --host 0.0.0.0 --port 1430",
    "dev:simulator:desktop": "tauri dev --config src-tauri/tauri.simulator.conf.json",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write src tools e2e *.json *.ts *.mjs index.html README.md src-tauri/*.json src-tauri/capabilities/*.json",
    "format:check": "prettier --check src tools e2e *.json *.ts *.mjs index.html README.md src-tauri/*.json src-tauri/capabilities/*.json",
    "tauri": "tauri",
    "test:browser": "playwright test",
    "helpers:build": "node tools/build-helpers.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@mantine/notifications": "9.8.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
