{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroTizen Desktop",
  "version": "0.1.0",
  "identifier": "org.aerotizen.desktop",
  "build": {
    "features": ["bundled-worker"],
    "beforeDevCommand": "npm run worker:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run worker:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "AeroTizen", "width": 1120, "height": 800, "minWidth": 560, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/aerotizen-worker"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.3" }
  }
}
