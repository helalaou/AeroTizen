{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroTizen Desktop",
  "version": "../package.json",
  "identifier": "org.aerotizen.desktop",
  "build": {
    "features": ["desktop-app"],
    "beforeDevCommand": "npm run helpers:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run helpers:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AeroTizen",
        "width": 980,
        "height": 730,
        "minWidth": 560,
        "minHeight": 730
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.3"
    }
  }
}
