{
  "name": "aerotizen-launcher",
  "private": true,
  "description": "AeroTizen launcher build, lint, format, and test tooling.",
  "scripts": {
    "lint": "eslint launcher tests eslint.config.js playwright.config.cjs vite.config.mts tools/build-launcher.mjs --max-warnings=0",
    "format": "prettier --write \"launcher/**/*.{js,ts,tsx,css,html,json}\" \"tests/**/*.{js,cjs}\" \"*.{js,cjs,mjs,mts,json}\" tools/build-launcher.mjs .github/workflows/ci.yml CONTRIBUTING.md",
    "format:check": "prettier --check \"launcher/**/*.{js,ts,tsx,css,html,json}\" \"tests/**/*.{js,cjs}\" \"*.{js,cjs,mjs,mts,json}\" tools/build-launcher.mjs .github/workflows/ci.yml CONTRIBUTING.md",
    "build": "npm run typecheck && node tools/build-launcher.mjs",
    "dev": "vite",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "npm run build && playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/babel__core": "7.20.5",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "acorn": "8.19.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
